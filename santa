<!DOCTYPE html>
<html lang="en" data-device="pc">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>WHAT WILL SANTA BRING CHÍP?</title>

  <!-- Google Font: Titan One (with safe cursive/system fallbacks) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Titan+One&display=swap" rel="stylesheet" />

  <style>
    /* =========================================================================
       1. DESIGN TOKENS & GLOBAL TYPOGRAPHY (TITAN ONE)
       ========================================================================= */
    :root {
      --bg-blush: #f9e4e6;
      --bg-blush-deep: #f4cfd4;
      --mauve: #6e233b;
      --mauve-dark: #4f1629;
      --mauve-soft: #9c4661;
      --white: #ffffff;
      --gold: #facc15;
      --shadow-soft: 0 14px 34px rgba(110, 35, 59, 0.16);
      --shadow-btn: 0 6px 16px rgba(110, 35, 59, 0.22);
      --font-main: "Titan One", "Fredoka One", "Arial Rounded MT Bold", cursive, system-ui, sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-blush);
      color: var(--mauve);
      font-family: var(--font-main);
    }

    button, input, video {
      font-family: var(--font-main);
    }

    /* =========================================================================
       2. SLIDE MANAGEMENT & DEVICE ADAPTIVE CONTAINERS (PC / IPAD / PHONE)
       ========================================================================= */
    .app-root {
      position: relative;
      width: 100vw;
      height: 100dvh;
      overflow: hidden;
      background: radial-gradient(circle at 50% 25%, #fff5f6 0%, var(--bg-blush) 65%, var(--bg-blush-deep) 100%);
    }

    .slide {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 20px;
      overflow-y: auto;
    }

    .slide.is-active {
      display: flex;
      animation: slideFadeIn 0.3s ease-out;
    }

    @keyframes slideFadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    html[data-device="phone"] .slide {
      padding: 14px 12px;
    }

    html[data-device="ipad"] .slide {
      padding: 22px 24px;
    }

    /* =========================================================================
       3. SHARED PILL BUTTONS
       ========================================================================= */
    .btn-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: none;
      border-radius: 999px;
      padding: 14px 30px;
      font-size: clamp(15px, 2.2vw, 19px);
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: var(--shadow-btn);
      transition: transform 0.14s ease, box-shadow 0.14s ease, background-color 0.16s ease;
    }

    .btn-pill:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 22px rgba(110, 35, 59, 0.28);
    }

    .btn-pill:active {
      transform: translateY(1px) scale(0.98);
    }

    .btn-white {
      background: var(--white);
      color: var(--mauve);
      border: 2px solid rgba(110, 35, 59, 0.1);
    }

    .btn-white:hover {
      background: #fffafb;
    }

    .btn-mauve {
      background: var(--mauve);
      color: var(--white);
    }

    .btn-mauve:hover {
      background: var(--mauve-dark);
    }

    html[data-device="phone"] .btn-pill {
      padding: 12px 20px;
      font-size: 14px;
    }

    /* =========================================================================
       4. SLIDE 1: INTRO SLIDE ("WHAT WILL SANTA BRING CHÍP?")
       ========================================================================= */
    .intro-wrapper {
      width: 100%;
      max-width: 840px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: clamp(16px, 2.6vh, 26px);
      text-align: center;
    }

    html[data-device="ipad"] .intro-wrapper {
      max-width: 720px;
    }

    html[data-device="phone"] .intro-wrapper {
      max-width: 440px;
      gap: 16px;
    }

    .intro-title {
      margin: 0;
      font-size: clamp(26px, 4.8vw, 50px);
      line-height: 1.12;
      color: var(--mauve);
      letter-spacing: 0.03em;
      text-transform: uppercase;
      text-shadow: 0 3px 0 rgba(255, 255, 255, 0.85);
    }

    .video-card {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #241018;
      border: 6px solid var(--white);
      border-radius: 26px;
      overflow: hidden;
      box-shadow: 0 20px 44px rgba(110, 35, 59, 0.22);
    }

    html[data-device="phone"] .video-card {
      aspect-ratio: 16 / 10;
      border-width: 4px;
      border-radius: 20px;
    }

    .video-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      background: #1b0c12;
    }

    .intro-fallback-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: none;
    }

    .intro-fallback-canvas.is-visible {
      display: block;
    }

    .intro-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 16px;
      width: 100%;
    }

    /* =========================================================================
       5. SLIDE 2: MAIN BALANCE GAME STAGE
       ========================================================================= */
    #slide-game {
      padding: 0;
      overflow: hidden;
    }

    .game-stage {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      cursor: pointer;
      touch-action: none;
    }

    #game-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    .game-hud {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 15;
      pointer-events: none;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 10px;
      padding: clamp(12px, 2.2vh, 22px) clamp(14px, 3vw, 32px);
    }

    .hud-left {
      justify-self: start;
    }

    .hud-center {
      justify-self: center;
      text-align: center;
    }

    .hud-right {
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .hud-badge {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.94);
      color: var(--mauve);
      border: 3px solid var(--mauve);
      border-radius: 999px;
      padding: 8px 18px;
      font-size: clamp(14px, 2vw, 20px);
      box-shadow: 0 6px 16px rgba(110, 35, 59, 0.18);
      white-space: nowrap;
    }

    .hud-center-title {
      margin: 0;
      font-size: clamp(17px, 3.1vw, 34px);
      color: var(--white);
      letter-spacing: 0.03em;
      -webkit-text-stroke: 2px var(--mauve);
      paint-order: stroke fill;
      text-shadow: 0 4px 0 rgba(110, 35, 59, 0.35);
      line-height: 1.1;
    }

    .sound-toggle {
      pointer-events: auto;
      width: clamp(40px, 5vw, 48px);
      height: clamp(40px, 5vw, 48px);
      border-radius: 999px;
      border: 3px solid var(--mauve);
      background: rgba(255, 255, 255, 0.95);
      color: var(--mauve);
      font-size: clamp(18px, 2.4vw, 22px);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 6px 16px rgba(110, 35, 59, 0.18);
      transition: transform 0.12s ease;
    }

    .sound-toggle:active {
      transform: scale(0.92);
    }

    html[data-device="phone"] .game-hud {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      row-gap: 8px;
      padding: 10px 12px;
    }

    html[data-device="phone"] .hud-center {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    html[data-device="phone"] .hud-badge {
      padding: 6px 12px;
      font-size: 13px;
      border-width: 2px;
    }

    html[data-device="phone"] .hud-center-title {
      font-size: 18px;
      -webkit-text-stroke: 1.5px var(--mauve);
    }

    .wobble-banner {
      position: absolute;
      top: clamp(78px, 13vh, 108px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 16;
      pointer-events: none;
      display: none;
      background: #e11d48;
      color: #ffffff;
      border: 3px solid #ffffff;
      border-radius: 999px;
      padding: 6px 18px;
      font-size: clamp(12px, 1.8vw, 16px);
      letter-spacing: 0.04em;
      box-shadow: 0 8px 20px rgba(225, 29, 72, 0.35);
      white-space: nowrap;
    }

    .wobble-banner.is-visible {
      display: inline-block;
    }

    .drop-hint-banner {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 12;
      pointer-events: none;
      background: rgba(110, 35, 59, 0.88);
      color: var(--white);
      border: 2px solid rgba(255, 255, 255, 0.85);
      border-radius: 999px;
      padding: 6px 18px;
      font-size: clamp(11px, 1.6vw, 14px);
      letter-spacing: 0.04em;
      white-space: nowrap;
      transition: opacity 0.3s ease;
    }

    /* =========================================================================
       6. SLIDE 3: VICTORY / RESULT SLIDE ("DEAR SANTA, WHAT’S FOR CHÍP?")
       ========================================================================= */
    .victory-card {
      width: 100%;
      max-width: 680px;
      background: rgba(255, 255, 255, 0.96);
      border: 6px solid var(--white);
      border-radius: 32px;
      padding: clamp(18px, 3.2vh, 32px) clamp(18px, 4vw, 34px);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: clamp(12px, 2vh, 20px);
      box-shadow: 0 24px 54px rgba(110, 35, 59, 0.22);
    }

    .victory-heading {
      margin: 0;
      font-size: clamp(22px, 4vw, 40px);
      color: var(--mauve);
      line-height: 1.15;
      letter-spacing: 0.03em;
    }

    .snapshot-frame {
      width: 100%;
      max-width: 460px;
      aspect-ratio: 4 / 3;
      background: linear-gradient(180deg, #ffeef0 0%, #fbd5da 100%);
      border: 4px solid var(--mauve);
      border-radius: 24px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 4px 14px rgba(110, 35, 59, 0.12);
    }

    .snapshot-frame img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .victory-score-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .victory-score {
      font-size: clamp(22px, 4vw, 38px);
      color: var(--mauve);
      background: var(--bg-blush);
      border: 3px solid var(--mauve);
      border-radius: 999px;
      padding: 8px 26px;
      letter-spacing: 0.04em;
    }

    .perfect-badge {
      display: none;
      background: #15803d;
      color: #fef9c3;
      border: 3px solid #fde047;
      border-radius: 999px;
      padding: 8px 18px;
      font-size: clamp(13px, 2vw, 17px);
      letter-spacing: 0.04em;
    }

    .perfect-badge.is-visible {
      display: inline-block;
    }

    .victory-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 16px;
      width: 100%;
    }

    /* =========================================================================
       7. SLIDE 4: "KNOCK KNOCK KNOCK" SLIDE
       ========================================================================= */
    .knock-card {
      width: 100%;
      max-width: 620px;
      background: var(--white);
      border: 6px solid var(--mauve);
      border-radius: 32px;
      padding: clamp(32px, 6vh, 56px) 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
      box-shadow: var(--shadow-soft);
    }

    .knock-title {
      margin: 0;
      font-size: clamp(28px, 5.2vw, 52px);
      color: var(--mauve);
      letter-spacing: 0.04em;
    }

    .knock-sub {
      margin: 0;
      font-size: clamp(15px, 2.2vw, 20px);
      color: var(--mauve-soft);
    }
  </style>
</head>
<body>
  <div class="app-root">
    <!-- =====================================================================
         SLIDE 1: INTRO SLIDE ("WHAT WILL SANTA BRING CHÍP?")
         ===================================================================== -->
    <section id="slide-intro" class="slide is-active" aria-label="Intro Screen">
      <div class="intro-wrapper">
        <h1 class="intro-title">WHAT WILL SANTA BRING CHÍP?</h1>

        <div id="video-card" class="video-card">
          <video
            id="intro-video"
            src="intro-santa-video.mp4"
            muted
            playsinline
            controls
            preload="metadata"
          ></video>
          <canvas id="intro-fallback-canvas" class="intro-fallback-canvas"></canvas>
        </div>

        <div class="intro-controls">
          <button id="btn-replay-intro" type="button" class="btn-pill btn-white">
            <span>↻</span>
            <span>REPLAY INTRO</span>
          </button>

          <button id="btn-start-game" type="button" class="btn-pill btn-mauve">
            <span>START GAME</span>
            <span>→</span>
          </button>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         SLIDE 2: MAIN BALANCE GAME SLIDE
         ===================================================================== -->
    <section id="slide-game" class="slide" aria-label="Balance Game">
      <div id="game-stage" class="game-stage">
        <canvas id="game-canvas"></canvas>

        <header class="game-hud">
          <div class="hud-left">
            <div id="hud-score" class="hud-badge">0/10 GIFTS</div>
          </div>

          <div class="hud-center">
            <h2 class="hud-center-title">WHAT’S IN SANTA’S BAG?</h2>
          </div>

          <div class="hud-right">
            <div id="hud-timer" class="hud-badge">00:00</div>
            <button
              id="btn-sound"
              type="button"
              class="sound-toggle"
              aria-label="Toggle Background Music"
              title="Toggle Sound"
            >
              🔊
            </button>
          </div>
        </header>

        <div id="wobble-banner" class="wobble-banner">CAREFUL! WOBBLING!</div>

        <div id="drop-hint" class="drop-hint-banner">
          TAP / CLICK / PRESS SPACE TO DROP GIFT!
        </div>
      </div>
    </section>

    <!-- =====================================================================
         SLIDE 3: VICTORY / RESULT SLIDE ("DEAR SANTA, WHAT’S FOR CHÍP?")
         ===================================================================== -->
    <section id="slide-victory" class="slide" aria-label="Result Screen">
      <div class="victory-card">
        <h2 class="victory-heading">DEAR SANTA, WHAT’S FOR CHÍP?</h2>

        <div class="snapshot-frame">
          <img id="sleigh-snapshot-img" alt="Santa Sleigh with Stacked Gifts" />
        </div>

        <div class="victory-score-row">
          <div id="victory-score" class="victory-score">0/10 GIFTS</div>
          <div id="perfect-badge" class="perfect-badge">10/10 MASTER!</div>
        </div>

        <div class="victory-actions">
          <button id="btn-play-again" type="button" class="btn-pill btn-white">
            <span>PLAY AGAIN</span>
          </button>

          <button id="btn-gooooo" type="button" class="btn-pill btn-mauve">
            <span>GOOOOO!</span>
          </button>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         SLIDE 4: "KNOCK KNOCK KNOCK" SLIDE
         ===================================================================== -->
    <section id="slide-knock" class="slide" aria-label="Knock Knock Knock Screen">
      <div class="knock-card">
        <div style="font-size: 56px;">🚪🎄✨</div>
        <h2 class="knock-title">KNOCK KNOCK KNOCK</h2>
        <p class="knock-sub">COMING SOON...</p>
        <div class="victory-actions">
          <button id="btn-knock-start" type="button" class="btn-pill btn-mauve">
            <span>BACK TO START</span>
          </button>
        </div>
      </div>
    </section>
  </div>

  <!-- Background Audio Element -->
  <audio id="bgm-audio" src="santa-audio.mp3" loop preload="none"></audio>

  <script>
    (function () {
      "use strict";

      /* =======================================================================
         1. AUTOMATIC DEVICE DETECTION (PC / IPAD / PHONE)
         ======================================================================= */
      var deviceMode = "pc";

      function detectDeviceMode() {
        try {
          var ua = (navigator.userAgent || "").toLowerCase();
          var maxTouch = navigator.maxTouchPoints || 0;
          var w = window.innerWidth || document.documentElement.clientWidth || 1024;
          var h = window.innerHeight || document.documentElement.clientHeight || 768;
          var minSide = Math.min(w, h);

          var isIPadOS = (navigator.platform === "MacIntel" && maxTouch > 1) || /ipad/.test(ua);
          var isTabletAndroid = /android/.test(ua) && !/mobile/.test(ua);
          var isPhoneUA = /iphone|ipod|android.*mobile|windows phone|blackberry/.test(ua);

          if (isIPadOS || isTabletAndroid || (maxTouch > 0 && minSide >= 600 && w <= 1366)) {
            deviceMode = "ipad";
          } else if (isPhoneUA || w < 600) {
            deviceMode = "phone";
          } else {
            deviceMode = "pc";
          }

          document.documentElement.setAttribute("data-device", deviceMode);
          if (document.body) {
            document.body.setAttribute("data-device", deviceMode);
          }
        } catch (_err) {
          deviceMode = "pc";
        }
        return deviceMode;
      }

      detectDeviceMode();

      /* =======================================================================
         2. ASSET PRELOADER (.JPG BACKGROUND + TRANSPARENT .PNG SPRITES)
         ======================================================================= */
      var ASSET_FILES = {
        background: "background-img.jpg",
        santa: "santa-img.png",
        sleigh: "sleigh-img.png",
        gifts: [
          "gift-1-img.png",
          "gift-2-img.png",
          "gift-3-img.png",
          "gift-4-img.png",
          "gift-5-img.png",
          "gift-6-img.png",
          "gift-7-img.png",
          "gift-8-img.png",
          "gift-9-img.png",
          "gift-10-img.png"
        ]
      };

      var loadedImages = {
        background: null,
        santa: null,
        sleigh: null,
        gifts: [null, null, null, null, null, null, null, null, null, null]
      };

      function loadImageAsset(src, onDone) {
        try {
          var img = new Image();
          img.onload = function () {
            if ((img.naturalWidth || img.width) > 0) {
              onDone(img);
            } else {
              onDone(null);
            }
          };
          img.onerror = function () {
            onDone(null);
          };
          img.src = src;
        } catch (_err) {
          onDone(null);
        }
      }

      function preloadAllAssets() {
        loadImageAsset(ASSET_FILES.background, function (res) {
          loadedImages.background = res;
        });
        loadImageAsset(ASSET_FILES.santa, function (res) {
          loadedImages.santa = res;
        });
        loadImageAsset(ASSET_FILES.sleigh, function (res) {
          loadedImages.sleigh = res;
        });
        ASSET_FILES.gifts.forEach(function (src, index) {
          loadImageAsset(src, function (res) {
            loadedImages.gifts[index] = res;
          });
        });
      }

      preloadAllAssets();

      /* =======================================================================
         3. SAFE WEB AUDIO API SOUND ENGINE + SANTA-AUDIO.MP3 FALLBACK
         ======================================================================= */
      var SoundController = (function () {
        var audioCtx = null;
        var isMuted = false;
        var bgmTimer = null;
        var noteIndex = 0;
        var bgmAudioEl = document.getElementById("bgm-audio");
        var usingExternalAudio = false;

        var MELODY = [
          [659.25, 1], [659.25, 1], [659.25, 2],
          [659.25, 1], [659.25, 1], [659.25, 2],
          [659.25, 1], [783.99, 1], [523.25, 1.5], [587.33, 0.5], [659.25, 4],
          [698.46, 1], [698.46, 1], [698.46, 1.5], [698.46, 0.5],
          [698.46, 1], [659.25, 1], [659.25, 1], [659.25, 0.5], [659.25, 0.5],
          [659.25, 1], [587.33, 1], [587.33, 1], [659.25, 1], [587.33, 2], [783.99, 2]
        ];

        function ensureContext() {
          if (isMuted) return null;
          try {
            if (!audioCtx) {
              var Ctx = window.AudioContext || window.webkitAudioContext;
              if (!Ctx) return null;
              audioCtx = new Ctx();
            }
            if (audioCtx.state === "suspended") {
              var p = audioCtx.resume();
              if (p && typeof p.catch === "function") {
                p.catch(function () {});
              }
            }
            return audioCtx;
          } catch (_err) {
            return null;
          }
        }

        function playTone(freq, dur, type, gainVal) {
          if (isMuted) return;
          var ctx = ensureContext();
          if (!ctx || ctx.state !== "running") return;
          try {
            var now = ctx.currentTime;
            var osc = ctx.createOscillator();
            var gain = ctx.createGain();
            osc.type = type || "sine";
            osc.frequency.setValueAtTime(freq, now);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.linearRampToValueAtTime(gainVal || 0.05, now + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + dur + 0.02);
          } catch (_err) {}
        }

        function startSynthLoop() {
          if (bgmTimer) return;
          noteIndex = 0;
          function step() {
            if (isMuted || usingExternalAudio || currentSlide !== "game") {
              bgmTimer = null;
              return;
            }
            var item = MELODY[noteIndex % MELODY.length];
            var freq = item[0];
            var beats = item[1];
            var sec = beats * 0.24;
            playTone(freq, sec * 0.88, "triangle", 0.036);
            noteIndex++;
            bgmTimer = setTimeout(step, sec * 1000);
          }
          step();
        }

        function stopSynthLoop() {
          if (bgmTimer) {
            clearTimeout(bgmTimer);
            bgmTimer = null;
          }
        }

        function startBgm() {
          if (isMuted) return;
          ensureContext();

          if (bgmAudioEl && !usingExternalAudio) {
            try {
              var playPromise = bgmAudioEl.play();
              if (playPromise && typeof playPromise.then === "function") {
                playPromise
                  .then(function () {
                    usingExternalAudio = true;
                    stopSynthLoop();
                  })
                  .catch(function () {
                    usingExternalAudio = false;
                    startSynthLoop();
                  });
                return;
              }
            } catch (_err) {
              usingExternalAudio = false;
            }
          }

          if (usingExternalAudio && bgmAudioEl) {
            try {
              bgmAudioEl.play().catch(function () {
                usingExternalAudio = false;
                startSynthLoop();
              });
            } catch (_err) {
              usingExternalAudio = false;
              startSynthLoop();
            }
          } else {
            startSynthLoop();
          }
        }

        function stopBgm() {
          stopSynthLoop();
          if (bgmAudioEl) {
            try {
              bgmAudioEl.pause();
            } catch (_err) {}
          }
        }

        function toggleMute() {
          isMuted = !isMuted;
          if (isMuted) {
            stopBgm();
          } else if (currentSlide === "game") {
            startBgm();
          } else {
            playTone(587.33, 0.1, "sine", 0.06);
          }
          return isMuted;
        }

        function playDrop() {
          playTone(392, 0.09, "sine", 0.07);
        }

        function playLand(giftIndex, balanced) {
          var base = 440 + giftIndex * 24;
          playTone(base, 0.12, "triangle", 0.08);
          if (balanced) {
            setTimeout(function () {
              playTone(base * 1.25, 0.14, "sine", 0.07);
            }, 60);
          }
        }

        function playWobbleWarn() {
          playTone(230, 0.12, "triangle", 0.07);
        }

        function playCelebration() {
          var fanfare = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
          fanfare.forEach(function (n, idx) {
            setTimeout(function () {
              playTone(n, 0.22, "triangle", 0.09);
            }, idx * 105);
          });
        }

        return {
          unlock: ensureContext,
          startBgm: startBgm,
          stopBgm: stopBgm,
          toggleMute: toggleMute,
          playDrop: playDrop,
          playLand: playLand,
          playWobbleWarn: playWobbleWarn,
