      function computeLayoutMetrics() {
        try {
          detectDeviceMode();
          stageW = Math.max(300, window.innerWidth || 800);
          stageH = Math.max(460, window.innerHeight || 600);
          dpr = Math.min(window.devicePixelRatio || 1, 2);

          canvas.width = Math.round(stageW * dpr);
          canvas.height = Math.round(stageH * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          var oldSleighX = sleighState.x || stageW * 0.5;
          var oldSleighY = sleighState.y || stageH - 80;

          if (deviceMode === "phone") {
            santaState.w = Math.min(124, stageW * 0.3);
            santaState.h = santaState.w * 0.78;
            santaState.y = 112;
            santaState.speed = Math.max(155, stageW * 0.48);

            sleighState.w = Math.min(204, stageW * 0.52);
            sleighState.h = sleighState.w * 0.42;
            sleighState.x = stageW * 0.5;
            sleighState.y = stageH - 64;
          } else if (deviceMode === "ipad") {
            santaState.w = 152;
            santaState.h = 118;
            santaState.y = 118;
            santaState.speed = Math.max(210, stageW * 0.34);

            sleighState.w = 250;
            sleighState.h = 104;
            sleighState.x = stageW * 0.5;
            sleighState.y = stageH - 76;
          } else {
            santaState.w = 168;
            santaState.h = 128;
            santaState.y = 116;
            santaState.speed = Math.max(250, Math.min(390, stageW * 0.28));

            sleighState.w = 278;
            sleighState.h = 112;
            sleighState.x = stageW * 0.5;
            sleighState.y = stageH - 82;
          }

          var dx = sleighState.x - oldSleighX;
          var dy = sleighState.y - oldSleighY;
          for (var i = 0; i < stackedGifts.length; i++) {
            stackedGifts[i].x += dx;
            stackedGifts[i].y += dy;
          }
        } catch (_err) {}
      }

      function getGiftDimensions(giftIdx) {
        var baseW = deviceMode === "phone" ? 58 : deviceMode === "ipad" ? 70 : 76;
        var baseH = deviceMode === "phone" ? 44 : deviceMode === "ipad" ? 52 : 56;
        var scaleW = 1 + ((giftIdx % 3) - 1) * 0.055;
        var scaleH = 1 + (giftIdx % 2) * 0.05;
        return {
          w: Math.round(baseW * scaleW),
          h: Math.round(baseH * scaleH)
        };
      }

      function getSleighDeckY() {
        return sleighState.y - sleighState.h * 0.14;
      }

      function getCurrentTopSurface() {
        if (stackedGifts.length === 0) {
          return {
            x: sleighState.x,
            y: getSleighDeckY(),
            width: sleighState.w * 0.78
          };
        }
        var topGift = stackedGifts[stackedGifts.length - 1];
        return {
          x: topGift.x,
          y: topGift.y - topGift.h * 0.5,
          width: topGift.w
        };
      }

      function prepareNextCarrierGift() {
        if (currentGiftIndex >= 10) {
          activeCarrierGift = null;
          return;
        }
        var dims = getGiftDimensions(currentGiftIndex);
        activeCarrierGift = {
          index: currentGiftIndex,
          w: dims.w,
          h: dims.h
        };
      }

      function formatTime(totalSec) {
        var secs = Math.floor(totalSec);
        var mins = Math.floor(secs / 60);
        var rem = secs % 60;
        return (mins < 10 ? "0" : "") + mins + ":" + (rem < 10 ? "0" : "") + rem;
      }

      function updateHudDisplay() {
        hudScoreEl.textContent = scoreCount + "/10 GIFTS";
        hudTimerEl.textContent = formatTime(elapsedSeconds);
      }

      function startNewGame() {
        computeLayoutMetrics();
        initSnowflakes();

        stackedGifts = [];
        fallingGift = null;
        tumblingGifts = [];
        towerTiltAngle = 0;
        towerTiltVel = 0;
        towerTorqueBias = 0;
        lastWarnTime = -10;

        scoreCount = 0;
        elapsedSeconds = 0;
        currentGiftIndex = 0;
        phaseHoldTimer = 0;
        dropCooldown = 0;
        cameraOffsetY = 0;
        targetCameraOffsetY = 0;
        gamePhase = "playing";

        santaState.x = stageW * 0.5;
        santaState.dir = 1;

        wobbleBannerEl.classList.remove("is-visible");
        if (dropHintEl) dropHintEl.style.opacity = "1";

        prepareNextCarrierGift();
        updateHudDisplay();
      }

      function dropCurrentGift() {
        if (gamePhase !== "playing" || !activeCarrierGift || fallingGift || dropCooldown > 0) {
          return;
        }

        if (dropHintEl) dropHintEl.style.opacity = "0";
        dropCooldown = 0.22;

        fallingGift = {
          index: activeCarrierGift.index,
          w: activeCarrierGift.w,
          h: activeCarrierGift.h,
          x: santaState.x,
          y: santaState.y + santaState.h * 0.36 - cameraOffsetY,
          vx: santaState.dir * (santaState.speed * 0.08),
          vy: 140,
          angle: 0,
          angVel: 0
        };

        SoundController.playDrop();
        currentGiftIndex++;
        prepareNextCarrierGift();
      }

      function triggerToppleFailure(direction, looseGift) {
        if (gamePhase === "toppling" || gamePhase === "ended") return;
        gamePhase = "toppling";
        phaseHoldTimer = 0;
        wobbleBannerEl.classList.remove("is-visible");

        var dir = direction >= 0 ? 1 : -1;

        // Convert stacked gifts into tumbling rigid bodies
        for (var i = 0; i < stackedGifts.length; i++) {
          var sg = stackedGifts[i];
          tumblingGifts.push({
            index: sg.index,
            w: sg.w,
            h: sg.h,
            x: sg.x,
            y: sg.y,
            vx: dir * (55 + i * 16),
            vy: -45 - i * 12,
            angle: sg.angle || 0,
            angVel: dir * (1.8 + i * 0.24)
          });
        }
        stackedGifts = [];

        if (looseGift) {
          tumblingGifts.push({
            index: looseGift.index,
            w: looseGift.w,
            h: looseGift.h,
            x: looseGift.x,
            y: looseGift.y,
            vx: dir * 95,
            vy: Math.max(80, looseGift.vy * 0.45),
            angle: looseGift.angle || 0,
            angVel: dir * 2.8
          });
        }
        fallingGift = null;
      }

      function handleGiftLanding(gift) {
        var surface = getCurrentTopSurface();
        // Account for current tower tilt when checking effective landing center
        var heightAboveSleigh = Math.max(0, getSleighDeckY() - surface.y);
        var tiltedSurfaceX = surface.x + Math.sin(towerTiltAngle) * heightAboveSleigh;

        var offsetX = gift.x - tiltedSurfaceX;
        var halfSupport = (surface.width + gift.w) * 0.46;
        var offsetRatio = offsetX / Math.max(1, halfSupport);

        // Missed the sleigh or landed too far off the edge -> topple & end round
        if (Math.abs(offsetRatio) > 0.96) {
          gift.y = surface.y - gift.h * 0.45;
          triggerToppleFailure(offsetX >= 0 ? 1 : -1, gift);
          return;
        }

        // Landed on the stack!
        var landedItem = {
          index: gift.index,
          w: gift.w,
          h: gift.h,
          x: tiltedSurfaceX + offsetX * 0.92,
          y: surface.y - gift.h * 0.5,
          angle: offsetRatio * 0.04,
          squishPhase: 0,
          squishAmp: Math.min(0.14, 0.04 + Math.abs(offsetRatio) * 0.09)
        };

        stackedGifts.push(landedItem);
        fallingGift = null;

        scoreCount = Math.min(10, stackedGifts.length);
        updateHudDisplay();

        // Update cumulative center-of-mass torque and wobble velocity
        var heightFactor = 1 + stackedGifts.length * 0.09;
        towerTorqueBias += offsetRatio * 0.055 * heightFactor;
        towerTiltVel += offsetRatio * 0.48 * heightFactor;
        towerTiltAngle += offsetRatio * 0.042 * heightFactor;

        var isWellBalanced = Math.abs(offsetRatio) <= 0.18;
        if (isWellBalanced) {
          towerTorqueBias *= 0.72;
          towerTiltAngle *= 0.8;
          towerTiltVel *= 0.75;
        }

        SoundController.playLand(landedItem.index, isWellBalanced);

        // Check if cumulative center-of-mass torque tips the tower over
        if (Math.abs(towerTiltAngle) >= 0.34 || Math.abs(towerTorqueBias) >= 0.28) {
          triggerToppleFailure(towerTiltAngle >= 0 ? 1 : -1, null);
          return;
        }

        // Check if all 10 gifts are successfully stacked
        if (scoreCount >= 10) {
          gamePhase = "victory_hold";
          phaseHoldTimer = 0;
          wobbleBannerEl.classList.remove("is-visible");
        }
      }

      /* =======================================================================
         6. CAPTURE SLEIGH + STACKED GIFTS SNAPSHOT FOR VICTORY SLIDE
         ======================================================================= */
      function captureSleighSnapshotDataURL() {
        try {
          var snapW = 640;
          var snapH = 480;
          var snapCanvas = document.createElement("canvas");
          snapCanvas.width = snapW;
          snapCanvas.height = snapH;
          var sctx = snapCanvas.getContext("2d");

          var grad = sctx.createLinearGradient(0, 0, 0, snapH);
          grad.addColorStop(0, "#fff2f4");
          grad.addColorStop(1, "#f9d6dc");
          sctx.fillStyle = grad;
          sctx.fillRect(0, 0, snapW, snapH);

          sctx.fillStyle = "rgba(255, 255, 255, 0.85)";
          for (var i = 0; i < 28; i++) {
            sctx.beginPath();
            sctx.arc((i * 73) % snapW, (i * 47) % (snapH - 50), 3 + (i % 3), 0, Math.PI * 2);
            sctx.fill();
          }

          var minX = sleighState.x - sleighState.w * 0.65;
          var maxX = sleighState.x + sleighState.w * 0.65;
          var minY = sleighState.y - sleighState.h * 0.85;
          var maxY = sleighState.y + sleighState.h * 0.55;

          for (var g = 0; g < stackedGifts.length; g++) {
            var sg = stackedGifts[g];
            minX = Math.min(minX, sg.x - sg.w * 0.85);
            maxX = Math.max(maxX, sg.x + sg.w * 0.85);
            minY = Math.min(minY, sg.y - sg.h * 0.95);
          }

          var boxW = Math.max(240, maxX - minX);
          var boxH = Math.max(180, maxY - minY);
          var fitScale = Math.min((snapW * 0.82) / boxW, (snapH * 0.82) / boxH);
          var centerX = (minX + maxX) * 0.5;
          var centerY = (minY + maxY) * 0.5;

          sctx.save();
          sctx.translate(snapW * 0.5, snapH * 0.54);
          sctx.scale(fitScale, fitScale);
          sctx.translate(-centerX, -centerY);

          // Draw sleigh
          drawSleighGraphic(sctx, sleighState.x, sleighState.y, sleighState.w, sleighState.h);

          // Draw exact stacked gifts state with current tower tilt
          var pivotY = getSleighDeckY();
          sctx.save();
          sctx.translate(sleighState.x, pivotY);
          sctx.rotate(towerTiltAngle);
          sctx.translate(-sleighState.x, -pivotY);

          for (var k = 0; k < stackedGifts.length; k++) {
            var item = stackedGifts[k];
            drawGiftGraphic(sctx, item.index, item.x, item.y, item.w, item.h, item.angle || 0, 1, 1);
          }
          sctx.restore();

          sctx.restore();
          return snapCanvas.toDataURL("image/png");
        } catch (_err) {
          return "";
        }
      }

      function finishGameAndShowVictory() {
        if (gamePhase === "ended") return;
        gamePhase = "ended";
