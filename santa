        setTimeout(function () {
          showSlide("victory");
        }, 380);
      }

      /* =======================================================================
         7. CANVAS DRAWING HELPERS (PURE CANVAS 2D, NO roundRect)
         ======================================================================= */
      function traceRoundedBox(c, x, y, w, h, r) {
        var rad = Math.max(2, Math.min(r, w * 0.5, h * 0.5));
        c.beginPath();
        c.moveTo(x + rad, y);
        c.lineTo(x + w - rad, y);
        c.arc(x + w - rad, y + rad, rad, -Math.PI * 0.5, 0, false);
        c.lineTo(x + w, y + h - rad);
        c.arc(x + w - rad, y + h - rad, rad, 0, Math.PI * 0.5, false);
        c.lineTo(x + rad, y + h);
        c.arc(x + rad, y + h - rad, rad, Math.PI * 0.5, Math.PI, false);
        c.lineTo(x, y + rad);
        c.arc(x + rad, y + rad, rad, Math.PI, Math.PI * 1.5, false);
        c.closePath();
      }

      function drawBackground(c) {
        if (loadedImages.background) {
          var img = loadedImages.background;
          var iw = img.naturalWidth || img.width;
          var ih = img.naturalHeight || img.height;
          if (iw && ih) {
            var scale = Math.max(stageW / iw, stageH / ih);
            var dw = iw * scale;
            var dh = ih * scale;
            c.drawImage(img, (stageW - dw) * 0.5, (stageH - dh) * 0.5, dw, dh);
            return;
          }
        }

        var sky = c.createLinearGradient(0, 0, 0, stageH);
        sky.addColorStop(0, "#f9d6dc");
        sky.addColorStop(0.55, "#fce7ea");
        sky.addColorStop(1, "#fff6f7");
        c.fillStyle = sky;
        c.fillRect(0, 0, stageW, stageH);

        c.fillStyle = "#ffffff";
        c.beginPath();
        c.moveTo(0, stageH);
        c.lineTo(0, stageH - 70);
        c.quadraticCurveTo(stageW * 0.25, stageH - 108, stageW * 0.55, stageH - 72);
        c.quadraticCurveTo(stageW * 0.82, stageH - 42, stageW, stageH - 80);
        c.lineTo(stageW, stageH);
        c.closePath();
        c.fill();
      }

      function drawSantaGraphic(c, x, y, w, h) {
        c.save();
        c.translate(x, y);

        if (loadedImages.santa) {
          c.drawImage(loadedImages.santa, -w * 0.5, -h * 0.5, w, h);
          c.restore();
          return;
        }

        c.fillStyle = "#b45309";
        c.strokeStyle = "#4f1629";
        c.lineWidth = 3;
        c.beginPath();
        c.ellipse(-w * 0.24, h * 0.04, w * 0.24, h * 0.3, -0.25, 0, Math.PI * 2);
        c.fill();
        c.stroke();

        c.fillStyle = "#dc2626";
        traceRoundedBox(c, -w * 0.2, -h * 0.08, w * 0.44, h * 0.46, 18);
        c.fill();
        c.stroke();

        c.fillStyle = "#fed7aa";
        c.beginPath();
        c.arc(w * 0.04, -h * 0.18, h * 0.2, 0, Math.PI * 2);
        c.fill();
        c.stroke();

        c.fillStyle = "#ffffff";
        c.beginPath();
        c.arc(w * 0.04, -h * 0.08, h * 0.19, 0, Math.PI);
        c.fill();
        c.stroke();

        c.fillStyle = "#dc2626";
        c.beginPath();
        c.moveTo(-w * 0.14, -h * 0.25);
        c.lineTo(w * 0.04, -h * 0.48);
        c.lineTo(w * 0.22, -h * 0.25);
        c.closePath();
        c.fill();
        c.stroke();

        c.fillStyle = "#ffffff";
        traceRoundedBox(c, -w * 0.16, -h * 0.29, w * 0.4, h * 0.09, 8);
        c.fill();
        c.stroke();

        c.beginPath();
        c.arc(w * 0.04, -h * 0.49, h * 0.06, 0, Math.PI * 2);
        c.fill();
        c.stroke();

        c.restore();
      }

      function drawSleighGraphic(c, x, y, w, h) {
        c.save();
        c.translate(x, y);

        if (loadedImages.sleigh) {
          c.drawImage(loadedImages.sleigh, -w * 0.5, -h * 0.5, w, h);
          c.restore();
          return;
        }

        var hw = w * 0.5;
        var hh = h * 0.5;

        c.strokeStyle = "#d97706";
        c.lineWidth = 6;
        c.lineCap = "round";
        c.beginPath();
        c.moveTo(-hw * 0.85, hh * 0.78);
        c.lineTo(hw * 0.85, hh * 0.78);
        c.quadraticCurveTo(hw * 1.04, hh * 0.74, hw * 0.96, hh * 0.44);
        c.stroke();

        c.beginPath();
        c.moveTo(-hw * 0.45, hh * 0.35);
        c.lineTo(-hw * 0.45, hh * 0.78);
        c.moveTo(hw * 0.45, hh * 0.35);
        c.lineTo(hw * 0.45, hh * 0.78);
        c.stroke();

        c.fillStyle = "#9f1239";
        c.strokeStyle = "#4f1629";
        c.lineWidth = 3.5;
        traceRoundedBox(c, -hw * 0.82, -hh * 0.15, w * 0.82, h * 0.56, 20);
        c.fill();
        c.stroke();

        c.fillStyle = "#facc15";
        traceRoundedBox(c, -hw * 0.86, -hh * 0.24, w * 0.86, h * 0.16, 10);
        c.fill();
        c.stroke();

        c.restore();
      }

      function drawGiftGraphic(c, giftIdx, x, y, w, h, angle, sx, sy) {
        c.save();
        c.translate(x, y);
        c.rotate(angle || 0);
        c.scale(sx || 1, sy || 1);

        var img = loadedImages.gifts[giftIdx];
        if (img) {
          c.drawImage(img, -w * 0.5, -h * 0.5, w, h);
          c.restore();
          return;
        }

        var preset = GIFT_PRESETS[giftIdx % GIFT_PRESETS.length];
        var hw = w * 0.5;
        var hh = h * 0.5;

        c.fillStyle = preset.box;
        c.strokeStyle = "#4f1629";
        c.lineWidth = 3;
        traceRoundedBox(c, -hw, -hh, w, h, 10);
        c.fill();
        c.stroke();

        c.fillStyle = preset.ribbon;
        c.fillRect(-w * 0.1, -hh + 1.5, w * 0.2, h - 3);
        c.fillRect(-hw + 1.5, -h * 0.12, w - 3, h * 0.24);

        c.fillStyle = "#ffffff";
        c.beginPath();
        c.arc(0, 0, Math.min(w, h) * 0.24, 0, Math.PI * 2);
        c.fill();
        c.stroke();

        c.fillStyle = "#6e233b";
        c.font = "bold " + Math.round(Math.min(w, h) * 0.28) + "px 'Titan One', sans-serif";
        c.textAlign = "center";
        c.textBaseline = "middle";
        c.fillText(preset.label, 0, 1);

        c.restore();
      }

      /* =======================================================================
         8. MAIN SIMULATION & RENDER LOOP
         ======================================================================= */
      function updateGameWorld(dt) {
        // Update snow particles
        for (var i = 0; i < snowFlakes.length; i++) {
          var f = snowFlakes[i];
          f.y += f.vy * dt;
          f.x += f.vx * dt;
          if (f.y > stageH + 8) {
            f.y = -8;
            f.x = Math.random() * stageW;
          }
          if (f.x < -8) f.x = stageW + 8;
          if (f.x > stageW + 8) f.x = -8;
        }

        if (currentSlide !== "game" || gamePhase === "ended") return;

        elapsedSeconds += dt;
        updateHudDisplay();

        if (dropCooldown > 0) {
          dropCooldown = Math.max(0, dropCooldown - dt);
        }

        // Move Santa horizontally across the top
        var margin = Math.max(santaState.w * 0.55, 65);
        santaState.x += santaState.dir * santaState.speed * dt;
        if (santaState.x >= stageW - margin) {
          santaState.x = stageW - margin;
          santaState.dir = -1;
        } else if (santaState.x <= margin) {
          santaState.x = margin;
          santaState.dir = 1;
        }

        // Animate squish on stacked gifts
        for (var k = 0; k < stackedGifts.length; k++) {
          stackedGifts[k].squishPhase += dt * 12;
          stackedGifts[k].squishAmp *= Math.pow(0.06, dt);
        }

        // Tower balance & wobble spring physics
        if (gamePhase === "playing" && stackedGifts.length > 0) {
          var restoringForce = -3.4 * (towerTiltAngle - towerTorqueBias);
          var damping = Math.pow(0.32, dt);
          towerTiltVel = (towerTiltVel + restoringForce * dt) * damping;
          towerTiltAngle += towerTiltVel * dt;

          if (Math.abs(towerTiltAngle) > 0.14) {
            wobbleBannerEl.classList.add("is-visible");
            if (elapsedSeconds - lastWarnTime > 1.3) {
              lastWarnTime = elapsedSeconds;
              SoundController.playWobbleWarn();
            }
          } else {
            wobbleBannerEl.classList.remove("is-visible");
          }

          if (Math.abs(towerTiltAngle) >= 0.34) {
            triggerToppleFailure(towerTiltAngle >= 0 ? 1 : -1, null);
            return;
          }
        }

        // Update falling gift under gravity
        if (fallingGift) {
          fallingGift.vy += 1480 * dt;
          fallingGift.x += fallingGift.vx * dt;
          fallingGift.y += fallingGift.vy * dt;

          var surface = getCurrentTopSurface();
          if (fallingGift.y + fallingGift.h * 0.5 >= surface.y) {
            handleGiftLanding(fallingGift);
          } else if (fallingGift.y > sleighState.y + sleighState.h * 0.6) {
            triggerToppleFailure(fallingGift.x >= sleighState.x ? 1 : -1, fallingGift);
          }
        }

        // Toppling animation before showing Victory / Result slide
        if (gamePhase === "toppling") {
          for (var t = 0; t < tumblingGifts.length; t++) {
            var tg = tumblingGifts[t];
            tg.vy += 1200 * dt;
            tg.x += tg.vx * dt;
            tg.y += tg.vy * dt;
            tg.angle += tg.angVel * dt;
          }
          phaseHoldTimer += dt;
          if (phaseHoldTimer >= 0.72) {
            finishGameAndShowVictory();
            return;
          }
        }

        // Victory celebration hold after stacking all 10 gifts
        if (gamePhase === "victory_hold") {
          phaseHoldTimer += dt;
          if (phaseHoldTimer >= 1.1) {
            finishGameAndShowVictory();
            return;
          }
        }

        // Smooth camera upward lift as stack grows
        var topSurface = getCurrentTopSurface();
        var desiredTop = stageH * 0.44;
        targetCameraOffsetY = Math.max(0, desiredTop - topSurface.y);
        cameraOffsetY += (targetCameraOffsetY - cameraOffsetY) * Math.min(1, dt * 5.5);
      }

      function renderGameWorld() {
        try {
          ctx.clearRect(0, 0, stageW, stageH);
          drawBackground(ctx);

          ctx.save();
          ctx.translate(0, cameraOffsetY);

          // Centered stationary sleigh
          drawSleighGraphic(ctx, sleighState.x, sleighState.y, sleighState.w, sleighState.h);

          // Stacked gifts rotating smoothly around sleigh deck pivot
          if (stackedGifts.length > 0) {
            var pivotY = getSleighDeckY();
            ctx.save();
            ctx.translate(sleighState.x, pivotY);
            ctx.rotate(towerTiltAngle);
            ctx.translate(-sleighState.x, -pivotY);

            for (var i = 0; i < stackedGifts.length; i++) {
              var sg = stackedGifts[i];
              var sq = Math.sin(sg.squishPhase) * sg.squishAmp;
              drawGiftGraphic(
                ctx,
                sg.index,
                sg.x,
                sg.y,
                sg.w,
                sg.h,
                sg.angle || 0,
                1 + sq * 0.5,
                1 - sq * 0.4
              );
            }
            ctx.restore();
          }

          // Active falling gift
          if (fallingGift) {
            drawGiftGraphic(
              ctx,
              fallingGift.index,
              fallingGift.x,
              fallingGift.y,
              fallingGift.w,
              fallingGift.h,
              fallingGift.angle || 0,
              1,
              1
            );
          }

          // Tumbling gifts during topple
          for (var t = 0; t < tumblingGifts.length; t++) {
            var tg = tumblingGifts[t];
            drawGiftGraphic(ctx, tg.index, tg.x, tg.y, tg.w, tg.h, tg.angle, 1, 1);
          }

          ctx.restore();

          // Santa & next gift at top
          if (activeCarrierGift && gamePhase === "playing") {
            var carrierY = santaState.y + santaState.h * 0.36;
            drawGiftGraphic(
              ctx,
              activeCarrierGift.index,
              santaState.x,
              carrierY,
              activeCarrierGift.w,
              activeCarrierGift.h,
              Math.sin(elapsedSeconds * 5) * 0.06,
              1,
              1
            );
          }
          drawSantaGraphic(ctx, santaState.x, santaState.y, santaState.w, santaState.h);

          // Falling snow overlay
          for (var s = 0; s < snowFlakes.length; s++) {
            var flake = snowFlakes[s];
            ctx.save();
            ctx.globalAlpha = flake.alpha;
            ctx.fillStyle = "#ffffff";
            ctx.beginPath();
            ctx.arc(flake.x, flake.y, flake.r, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        } catch (_err) {}
      }

      function mainLoop(timestamp) {
        try {
          if (!lastTimestamp) lastTimestamp = timestamp;
          var dt = Math.min(0.05, Math.max(0.001, (timestamp - lastTimestamp) / 1000));
          lastTimestamp = timestamp;

          if (currentSlide === "intro") {
            renderIntroFallback(dt);
          } else if (currentSlide === "game") {
            updateGameWorld(dt);
            renderGameWorld();
          }
        } catch (_err) {}
        window.requestAnimationFrame(mainLoop);
      }

      /* =======================================================================
         9. INPUT HANDLERS (TOUCH, MOUSE CLICK & SPACEBAR)
         ======================================================================= */
      var gameStageEl = document.getElementById("game-stage");

      gameStageEl.addEventListener("pointerdown", function (ev) {
        if (ev.target && ev.target.closest("button")) return;
        ev.preventDefault();
        SoundController.unlock();
        dropCurrentGift();
      });

      window.addEventListener("keydown", function (ev) {
        if (ev.code === "Space" || ev.key === " ") {
          if (currentSlide === "game") {
            ev.preventDefault();
            SoundController.unlock();
            dropCurrentGift();
          }
        }
      });

      window.addEventListener("resize", computeLayoutMetrics);

      computeLayoutMetrics();
      initSnowflakes();
      window.requestAnimationFrame(mainLoop);
    })();
  </script>
</body>
