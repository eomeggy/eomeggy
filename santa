      function initSnowflakes() {
        snowFlakes = [];
        var count = deviceMode === "phone" ? 44 : 72;
        for (var i = 0; i < count; i++) {
          snowFlakes.push({
            x: Math.random() * stageW,
            y: Math.random() * stageH,
            r: 2 + Math.random() * 3.4,
            vy: 35 + Math.random() * 55,
